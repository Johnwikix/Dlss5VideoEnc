<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Platforms>x64</Platforms>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyName>Dlss5VideoEnc</AssemblyName>
    <RootNamespace>Dlss5Demo.App</RootNamespace>
    <ApplicationIcon>Assets\dlss5-video-enc.ico</ApplicationIcon>
    <!-- Disable the optional Avalonia build telemetry task in restricted/offline builds. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/build/**</DefaultItemExcludes>
    <!-- Frame loops need optimized code from their first invocation. -->
    <TieredCompilation Condition="'$(Configuration)' == 'Release'">false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\dlss5-video-enc.png" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dlss5Demo.Core\Dlss5Demo.Core.csproj" />
    <!-- 完整 runtime 随发布带走（宿主 DLL、全部 NR 显卡版本、RIFE 模型、进程内 FFmpeg 六库），
         按 runtime\ 子目录布局放置：DemoPaths 从 exe 目录逐级向上定位该目录。
         剔除进程内化后不再使用的 ffmpeg.exe/ffprobe.exe/avdevice（无任何模块依赖它）
         与非必需文档；LICENSE.txt 因 GPL 分发义务保留。 -->
    <None Include="..\..\runtime\**\*.dll;..\..\runtime\**\*.onnx;..\..\runtime\LICENSE.txt"
          Exclude="..\..\runtime\Cache\**;..\..\runtime\avdevice-63.dll;..\..\runtime\**\*.log"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Link="runtime\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
