<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Dlss5Demo.Core"
        x:Class="Dlss5Demo.App.MainWindow"
        Icon="/Assets/dlss5-video-enc.png"
        Title="DLSS5 Video Enc"
        Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F14"
        RequestedThemeVariant="Dark">
  <Window.Styles>
    <Style Selector="Border.settingsSection">
      <Setter Property="Background" Value="#111922"/>
      <Setter Property="BorderBrush" Value="#22313B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="#F3F7FA"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <Style Selector="TextBlock.subsectionTitle">
      <Setter Property="Foreground" Value="#D9E3EA"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="#A4B3BF"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#A4B3BF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MaxDropDownHeight" Value="320"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="16">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="DLSS5" FontSize="26" FontWeight="Bold" Foreground="#5CE1E6" /><TextBlock Text="VIDEO ENC" FontSize="26" FontWeight="Bold" Foreground="#F3F7FA" /></StackPanel>
        <TextBlock Text="DLSS NR / RTX Video 视频转码工作台 · 实时预览 · HDR 保真输出" Foreground="#8C9AA7" FontSize="13" />
      </StackPanel>
      <Border Grid.Column="1" Background="#14242A" BorderBrush="#27535A" BorderThickness="1" CornerRadius="18" Padding="16,10" MinWidth="190" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="#5CE1E6" VerticalAlignment="Center"/><TextBlock x:Name="RuntimeBadge" Text="DLSS Runtime · ready" Foreground="#B8F4F0" FontSize="12" VerticalAlignment="Center" /></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBox x:Name="InputBox" PlaceholderText="拖入或选择源视频（MP4 / MKV / MOV / TS / WebM）" TextChanged="OnInputTextChanged" FontSize="14" Padding="14,10"/><Button Grid.Column="1" x:Name="BrowseButton" Content="选择视频" Click="Browse_Click" Padding="18,10"/><Button Grid.Column="2" x:Name="CompareButton" Content="载入输出" Click="Compare_Click" IsEnabled="False" Padding="18,10"/></Grid>

    <Grid Grid.Row="2" ColumnDefinitions="420,16,*">
      <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <StackPanel Spacing="12">
            <Border Classes="settingsSection">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionTitle" Text="源视频"/>
                <TextBlock x:Name="InfoText" Text="尚未加载视频。" Classes="hint"/>
                <TextBlock x:Name="HdrSourceText" Text="" Foreground="#FFCF70" FontSize="12" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="OutputBox" PlaceholderText="输出文件路径"/>
                  <Button Grid.Column="1" Content="另存为" Click="PickOutput_Click"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="settingsSection">
              <StackPanel Spacing="12">
                <TextBlock Classes="sectionTitle" Text="DLSS NR"/>
                <CheckBox x:Name="EnableNrBox" Content="启用 DLSS NR" IsChecked="True"
                          AutomationProperties.AutomationId="EnableNr"
                          ToolTip.Tip="关闭后跳过 NR 及其运动矢量和历史累积，仍可使用 RTX Video 超分与独立补帧。"/>
                <StackPanel x:Name="NrSettings" Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="风格"/>
                  <ComboBox x:Name="StyleBox" SelectedIndex="0">
                    <ComboBoxItem Content="Default · 默认"/>
                    <ComboBoxItem Content="Natural · 自然"/>
                    <ComboBoxItem Content="Cinema · 电影"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                  <CheckBox x:Name="MotionGuidanceBox" Content="光流运动矢量" IsChecked="True"
                            ToolTip.Tip="估计当前帧到上一帧的运动，提供给 NR；关闭后不计算光流。"/>
                  <TextBlock Classes="hint" Text="对齐运动中的画面；启用后转码耗时增加。" Margin="28,0,0,0"/>
                  <CheckBox x:Name="FineMotionBox" Content="精细光流匹配（更慢）" Margin="28,2,0,0"
                            ToolTip.Tip="细化运动边缘的匹配；显卡不支持时自动回退到标准匹配。"/>
                  <CheckBox x:Name="ContinuousHistoryBox" Content="NR 连续历史" IsChecked="True"
                            ToolTip.Tip="保留 NR 连续帧历史并累积可信修正量；关闭后每帧重置 NR，停止修正量累积。"/>
                  <TextBlock Classes="hint" Text="利用前帧减轻闪烁；切镜时自动重置。" Margin="28,0,0,0"/>
                </StackPanel>
                <Separator Margin="0,4"/>
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="强度"/>
                    <TextBlock x:Name="IntensityValue" Grid.Column="1" Text="1.0×" Foreground="#5CE1E6"/>
                  </Grid>
                  <Slider x:Name="IntensitySlider" Minimum="0" Maximum="{x:Static core:DlssNrOptions.MaximumStrength}" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="局部色调"/>
                    <TextBlock x:Name="LocalToneValue" Grid.Column="1" Text="1.0×" Foreground="#B8F4F0"/>
                  </Grid>
                  <Slider x:Name="LocalToneSlider" Minimum="0" Maximum="{x:Static core:DlssNrOptions.MaximumStrength}" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="局部结构"/>
                    <TextBlock x:Name="LocalStructValue" Grid.Column="1" Text="1.0×" Foreground="#B8F4F0"/>
                  </Grid>
                  <Slider x:Name="LocalStructSlider" Minimum="0" Maximum="{x:Static core:DlssNrOptions.MaximumStrength}" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="皮肤结构"/>
                    <TextBlock x:Name="SkinValue" Grid.Column="1" Text="0.5×" Foreground="#B8F4F0"/>
                  </Grid>
                  <Slider x:Name="SkinSlider" Minimum="0" Maximum="{x:Static core:DlssNrOptions.MaximumStrength}" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                </StackPanel>
                <CheckBox x:Name="AutoMaskBox" Content="自动掩码（保护人脸与皮肤）"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="settingsSection">
              <StackPanel Spacing="16">
                <TextBlock Classes="sectionTitle" Text="输出与滤镜"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="容器"/>
                    <ComboBox x:Name="ContainerBox" SelectedIndex="0">
                      <ComboBoxItem Content="MP4"/><ComboBoxItem Content="MKV"/>
                      <ComboBoxItem Content="MOV"/><ComboBoxItem Content="AVI"/><ComboBoxItem Content="GIF"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="视频编码"/>
                    <ComboBox x:Name="CodecBox" SelectedIndex="1">
                      <ComboBoxItem Content="H.264 / AVC"/><ComboBoxItem Content="H.265 / HEVC"/>
                      <ComboBoxItem Content="AV1"/><ComboBoxItem Content="VP9"/><ComboBoxItem Content="MPEG-4"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="编码硬件"/>
                  <ComboBox x:Name="HardwareBox" SelectedIndex="1">
                    <ComboBoxItem Content="CPU 软件编码"/><ComboBoxItem Content="NVIDIA NVENC"/>
                    <ComboBoxItem Content="Intel QSV"/><ComboBoxItem Content="AMD AMF"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="视频解码"/>
                  <ComboBox x:Name="DecodeModeBox" SelectedIndex="0" AutomationProperties.AutomationId="DecodeMode">
                    <ComboBoxItem Content="自动 · 优先 NVIDIA NVDEC"/>
                    <ComboBoxItem Content="强制 NVIDIA NVDEC"/>
                    <ComboBoxItem Content="CPU 软件解码"/>
                  </ComboBox>
                  <TextBlock Classes="hint" Text="自动模式在首帧初始化失败时改用软件解码；强制 NVDEC 则报告错误。"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="编码预设"/>
                    <ComboBox x:Name="EncoderPresetBox" SelectedIndex="2">
                      <ComboBoxItem Content="P1 · 最快"/><ComboBoxItem Content="P3 · 快速"/>
                      <ComboBoxItem Content="P5 · 平衡"/><ComboBoxItem Content="P7 · 最高质量"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="帧率"/>
                    <ComboBox x:Name="FpsBox" SelectedIndex="0">
                      <ComboBoxItem Content="跟随源视频"/><ComboBoxItem Content="固定 24 fps"/>
                      <ComboBoxItem Content="固定 30 fps"/><ComboBoxItem Content="固定 60 fps"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="HDR 输出"/>
                  <ComboBox x:Name="HdrBox" SelectedIndex="0">
                    <ComboBoxItem Content="自动跟随源视频"/><ComboBoxItem Content="强制 HDR10 / PQ"/>
                    <ComboBoxItem Content="强制 SDR"/>
                  </ComboBox>
                </StackPanel>
                <Separator/>
                <TextBlock Classes="subsectionTitle" Text="视频码率"/>
                <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="码率模式"/>
                    <ComboBox x:Name="RateControlBox" SelectedIndex="0">
                      <ComboBoxItem Content="质量优先"/><ComboBoxItem Content="固定码率"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="目标码率 · kbps"/>
                    <TextBox x:Name="VideoBitrateBox" Text="8000"/>
                  </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="fieldLabel" Text="质量 · CQ / CRF"/>
                    <TextBlock x:Name="QualityValue" Grid.Column="1" Text="19" Foreground="#5CE1E6"/>
                  </Grid>
                  <Slider x:Name="QualitySlider" Minimum="0" Maximum="51" Value="19" TickFrequency="1" IsSnapToTickEnabled="True"/>
                  <CheckBox x:Name="TwoPassBox" Content="软件编码启用两遍"/>
                </StackPanel>
                <Separator/>
                <TextBlock Classes="subsectionTitle" Text="音频"/>
                <StackPanel Spacing="4">
                  <TextBlock Classes="fieldLabel" Text="音频编码"/>
                  <ComboBox x:Name="AudioBox" SelectedIndex="0">
                    <ComboBoxItem Content="复制源音轨"/><ComboBoxItem Content="AAC"/><ComboBoxItem Content="MP3"/>
                    <ComboBoxItem Content="Opus"/><ComboBoxItem Content="Vorbis"/><ComboBoxItem Content="FLAC"/>
                    <ComboBoxItem Content="AC-3"/><ComboBoxItem Content="无音频"/>
                  </ComboBox>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="音频码率 · kbps"/>
                    <TextBox x:Name="AudioBitrateBox" Text="192"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="fieldLabel" Text="音频增益 · dB"/>
                    <TextBox x:Name="AudioGainBox" Text="0"/>
                  </StackPanel>
                </Grid>
                <Separator/>
                <StackPanel Spacing="4">
                  <TextBlock Classes="subsectionTitle" Text="RTX Video 超分"/>
                  <ComboBox x:Name="SuperResolutionBox" SelectedIndex="0">
                    <ComboBoxItem Tag="1" Content="关闭（原始分辨率）"/>
                    <ComboBoxItem Tag="2" Content="2×（RTX Video）"/>
                    <ComboBoxItem Tag="4" Content="4×（RTX Video）"/>
                  </ComboBox>
                  <CheckBox x:Name="NrBeforeSuperResolutionBox" Content="NR 前置（速度优先）" IsChecked="True" Margin="0,6,0,0"
                            ToolTip.Tip="勾选：先 NR，再超分。取消勾选：先超分，再 NR，可对照后置 NR 的视觉效果。"/>
                  <TextBlock x:Name="ProcessingOrderHint" Classes="hint" Text="超分已关闭：仅处理 DLSS NR。"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <CheckBox x:Name="EnableInterpolationBox" Content="启用补帧"
                            AutomationProperties.AutomationId="EnableInterpolation"/>
                  <ComboBox x:Name="InterpolationBackendBox" SelectedIndex="0" IsEnabled="False"
                            AutomationProperties.AutomationId="InterpolationBackend">
                    <ComboBoxItem Content="NVIDIA Vulkan 光流"/><ComboBoxItem Content="RIFE 4.25 Lite（GPU）"/><ComboBoxItem Content="RIFE 4.25（GPU）"/>
                  </ComboBox>
                  <ComboBox x:Name="InterpolationMultiplierBox" SelectedIndex="0" IsEnabled="False"
                            AutomationProperties.AutomationId="InterpolationMultiplier">
                    <ComboBoxItem Content="2× 帧率"/><ComboBoxItem Content="4× 帧率"/><ComboBoxItem Content="6× 帧率"/>
                  </ComboBox>
                  <TextBlock Classes="hint" Text="独立于 NR 与超分。Vulkan 支持 16 位 HDR；RIFE 当前仅支持 SDR 输入和输出，HDR 请使用 Vulkan。预览显示源帧。"/>
                </StackPanel>
                <Expander x:Name="FiltersExpander" Header="缩放、降噪与裁剪" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12" Margin="0,12,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="fieldLabel" Text="输出尺寸"/>
                      <ComboBox x:Name="ScaleBox" SelectedIndex="0">
                        <ComboBoxItem Content="保持原尺寸"/><ComboBoxItem Content="适应 1920×1080"/>
                        <ComboBoxItem Content="适应 2560×1440"/><ComboBoxItem Content="适应 3840×2160"/>
                      </ComboBox>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="降噪"/>
                        <ComboBox x:Name="DenoiseBox" SelectedIndex="0">
                          <ComboBoxItem Content="不降噪"/><ComboBoxItem Content="轻度降噪"/>
                          <ComboBoxItem Content="中度降噪"/><ComboBoxItem Content="强度降噪"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="fieldLabel" Text="去隔行"/>
                        <ComboBox x:Name="DeinterlaceBox" SelectedIndex="0">
                          <ComboBoxItem Content="不去隔行"/><ComboBoxItem Content="Yadif"/><ComboBoxItem Content="Bwdif"/>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <CheckBox x:Name="CropBox" Content="启用裁剪（像素）"/>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                      <StackPanel Spacing="4"><TextBlock Classes="fieldLabel" Text="上"/><TextBox x:Name="CropTopBox"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="fieldLabel" Text="下"/><TextBox x:Name="CropBottomBox"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Classes="fieldLabel" Text="左"/><TextBox x:Name="CropLeftBox"/></StackPanel>
                      <StackPanel Grid.Column="3" Spacing="4"><TextBlock Classes="fieldLabel" Text="右"/><TextBox x:Name="CropRightBox"/></StackPanel>
                    </Grid>
                  </StackPanel>
                </Expander>
                <Expander x:Name="GifExpander" Header="GIF 参数" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12" Margin="0,12,0,0">
                    <TextBlock Classes="hint" Text="选择 GIF 容器时生效。"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                      <StackPanel Spacing="4"><TextBlock Classes="fieldLabel" Text="宽度 · px"/><TextBox x:Name="GifWidthBox" Text="480"/></StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="fieldLabel" Text="帧率 · fps"/><TextBox x:Name="GifFpsBox" Text="15"/></StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4"><TextBlock Classes="fieldLabel" Text="颜色数"/><TextBox x:Name="GifColorsBox" Text="256"/></StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="fieldLabel" Text="抖动算法"/>
                      <ComboBox x:Name="GifDitherBox" SelectedIndex="1">
                        <ComboBoxItem Content="无抖动" Tag="none"/><ComboBoxItem Content="Bayer" Tag="bayer"/>
                        <ComboBoxItem Content="Floyd-Steinberg" Tag="floyd_steinberg"/>
                        <ComboBoxItem Content="Sierra2_4a" Tag="sierra2_4a"/>
                      </ComboBox>
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Classes="settingsSection">
          <StackPanel Spacing="8">
            <CheckBox x:Name="FramesLimitBox" Content="仅处理前 60 帧（冒烟测试）"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button x:Name="StartButton" Content="开始转码" Click="Start_Click" Padding="18,9"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Background="#2A9FA9" Foreground="#071014"/>
              <Button Grid.Column="1" x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Padding="18,9"/>
            </Grid>
            <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="StatusText" Text="就绪。" Classes="hint"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Column="2" RowDefinitions="*,Auto,Auto" RowSpacing="12">
        <Border Grid.Row="0" Background="#05080B" BorderBrush="#22313B" BorderThickness="1" CornerRadius="14" Padding="14">
          <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="LIVE PREVIEW" Foreground="#5CE1E6" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="双路实时帧 · 源视频与处理结果" Foreground="#A4B3BF" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock x:Name="LivePreviewText" Grid.Column="1" Text="等待源视频" Foreground="#91A2AF" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" MinHeight="160">
              <Border Background="#0A1016" BorderBrush="#182630" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="*,Auto">
                  <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="640" Height="360" Background="#05080B">
                      <Image x:Name="OriginalImage" Stretch="Uniform"/>
                      <TextBlock x:Name="SourcePlaceholder" Text="等待转码帧" Foreground="#A4B3BF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="SOURCE" Foreground="#B8F4F0" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                    </Grid>
                  </Viewbox>
                  <TextBlock Grid.Row="1" Text="SOURCE · 原始视频" Foreground="#91A2AF" FontSize="11" Margin="2,8,2,0"/>
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#0A1016" BorderBrush="#182630" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="*,Auto">
                  <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="640" Height="360" Background="#05080B">
                      <Image x:Name="ProcessedImage" Stretch="Uniform"/>
                      <TextBlock x:Name="OutputPlaceholder" Text="等待处理结果" Foreground="#A4B3BF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBlock Text="OUTPUT" Foreground="#5CE1E6" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                    </Grid>
                  </Viewbox>
                  <TextBlock Grid.Row="1" Text="OUTPUT · 处理结果" Foreground="#91A2AF" FontSize="11" Margin="2,8,2,0"/>
                </Grid>
              </Border>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="同步预览 · SOURCE ↔ OUTPUT" Foreground="#5CE1E6" TextWrapping="Wrap"/>
                <TextBlock x:Name="PreviewFrameText" Text="等待转码" Foreground="#A4B3BF" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Grid.Column="1" x:Name="PreviewTimeText" Text="00:00:00 / 00:00:00" Foreground="#A4B3BF" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <ProgressBar x:Name="PreviewProgress" Minimum="0" Maximum="100" Value="0" Height="6" VerticalAlignment="Center"/>
              <TextBlock x:Name="PreviewFpsText" Grid.Column="1" Text="预览 — fps" Foreground="#91A2AF" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="1" Background="#111922" BorderBrush="#22313B" BorderThickness="1" CornerRadius="12" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18">
            <TextBlock x:Name="PipelineStatus" Text="管线就绪 · 预览播放器待命" Foreground="#B8C7D1" TextWrapping="Wrap"/>
            <TextBlock x:Name="FramesText" Grid.Column="1" Text="0 帧" Foreground="#91A2AF"/>
            <TextBlock x:Name="SpeedText" Grid.Column="2" Text="— fps" Foreground="#91A2AF"/>
            <TextBlock x:Name="OutputText" Grid.Column="3" Text="—" Foreground="#5CE1E6"/>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="#070B0F" BorderBrush="#1B2932" BorderThickness="1" CornerRadius="10" Padding="10">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="运行日志" Foreground="#91A2AF" FontSize="12"/>
              <Button Grid.Column="1" Content="清空" Click="ClearLog_Click" Padding="8,3"/>
            </Grid>
            <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Height="110"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
